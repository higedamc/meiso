<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status-bar icon: a speech bubble with a check mark ("a comment on a task").
     Android renders notification small icons from the ALPHA channel only and fills it with the
     system tint colour, so the shape must live in alpha: both the bubble and the check are
     strokes on a transparent background. An opaque bubble with an opaque check drawn on top
     would merge into a single tinted blob. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- speech bubble outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M4,2h16c1.1,0 2,0.9 2,2v11c0,1.1 -0.9,2 -2,2H8l-4,4v-4H4c-1.1,0 -2,-0.9 -2,-2V4c0,-1.1 0.9,-2 2,-2z" />
    <!-- check mark -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7.5,9.5l3,3l6,-6" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status-bar icon (white silhouette on transparent): a speech bubble with a check
     mark, i.e. "a comment on a task". Android tints small icons, so no colour is used here. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- speech bubble -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,2h16c1.1,0 2,0.9 2,2v11c0,1.1 -0.9,2 -2,2H8l-4,4v-4H4c-1.1,0 -2,-0.9 -2,-2V4c0,-1.1 0.9,-2 2,-2z" />
    <!-- check mark cut out of the bubble -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7.5,9.5l3,3l6,-6" />
</vector>
